import org.fuchss.projectvault.model.AccountType;

-- A financial account. Money is stored as integer minor units (cents) to avoid float error.
CREATE TABLE account (
    id TEXT NOT NULL PRIMARY KEY,
    name TEXT NOT NULL,
    type TEXT AS AccountType NOT NULL,
    currency TEXT NOT NULL DEFAULT 'EUR',
    institution TEXT,
    iban TEXT,
    openingBalanceCents INTEGER NOT NULL DEFAULT 0,
    openingDate INTEGER,
    createdAt INTEGER NOT NULL,
    -- Opt-in for live securities prices (DEPOT accounts). Off by default: enabling it is the only
    -- thing that ever lets this app talk to the network. Stored in the vault so the choice travels
    -- with the file rather than living in per-machine UI prefs.
    liveQuotes INTEGER NOT NULL DEFAULT 0
);

selectAllAccounts:
SELECT * FROM account ORDER BY name;

selectAccount:
SELECT * FROM account WHERE id = ?;

insertAccount:
INSERT INTO account(id, name, type, currency, institution, iban, openingBalanceCents, openingDate, createdAt)
VALUES (?, ?, ?, ?, ?, ?, ?, ?, ?);

setLiveQuotes:
UPDATE account SET liveQuotes = ? WHERE id = ?;

deleteAccount:
DELETE FROM account WHERE id = ?;
