-- A securities position for a DEPOT account. Holdings are kept as DATED SNAPSHOTS (one set per
-- valuationDate) so a portfolio can be traced over time; re-importing the same Depotauszug replaces
-- only that date's snapshot. Quantity/price kept as text (fractional shares, >2-decimal prices);
-- market value is integer cents.
CREATE TABLE holding (
    id TEXT NOT NULL PRIMARY KEY,
    accountId TEXT NOT NULL,
    importBatchId TEXT,
    isin TEXT,
    wkn TEXT,
    name TEXT NOT NULL,
    quantity TEXT NOT NULL,
    priceText TEXT,
    marketValueCents INTEGER NOT NULL,
    currency TEXT NOT NULL DEFAULT 'EUR',
    valuationDate INTEGER,
    quoteAt INTEGER,                 -- epoch millis of the live quote behind this row; NULL = statement value
    FOREIGN KEY (accountId) REFERENCES account(id) ON DELETE CASCADE
);

CREATE INDEX holding_account ON holding(accountId);

selectHoldingsForValuationDate:
SELECT * FROM holding WHERE accountId = ? AND valuationDate = ? ORDER BY marketValueCents DESC;

latestValuationDate:
SELECT MAX(valuationDate) AS latest FROM holding WHERE accountId = ?;

valuationDates:
SELECT DISTINCT valuationDate FROM holding WHERE accountId = ? AND valuationDate IS NOT NULL ORDER BY valuationDate DESC;

deleteHoldingsForValuationDate:
DELETE FROM holding WHERE accountId = ? AND valuationDate = ?;

deleteHoldingsByBatch:
DELETE FROM holding WHERE importBatchId = ?;

deleteHoldingsByAccount:
DELETE FROM holding WHERE accountId = ?;

insertHolding:
INSERT INTO holding(id, accountId, importBatchId, isin, wkn, name, quantity, priceText, marketValueCents, currency, valuationDate, quoteAt)
VALUES (?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?);

-- Snapshot dates that came from an imported statement rather than a live price refresh. A live
-- refresh reprices from the newest of these, so repeated refreshes always derive from the bank's
-- numbers instead of from each other. Holdings with no batch (legacy rows) count as statement data.
statementValuationDates:
SELECT DISTINCT holding.valuationDate FROM holding
LEFT JOIN importBatch ON importBatch.id = holding.importBatchId
WHERE holding.accountId = ? AND holding.valuationDate IS NOT NULL
  AND (importBatch.kind IS NULL OR importBatch.kind != 'LIVE')
ORDER BY holding.valuationDate DESC;

-- Snapshot dates produced by a live price refresh, so the UI can mark them in the snapshot picker.
liveValuationDates:
SELECT DISTINCT holding.valuationDate FROM holding
JOIN importBatch ON importBatch.id = holding.importBatchId
WHERE holding.accountId = ? AND holding.valuationDate IS NOT NULL AND importBatch.kind = 'LIVE';
